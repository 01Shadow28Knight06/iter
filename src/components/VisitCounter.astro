---
// src/components/VisitCounter.astro
---

<div 
  id="telemetry-counter-wrapper"
  class="font-mono text-xs text-[var(--color-ink-muted)] inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-[var(--color-rule)] bg-[var(--color-paper)]"
  title="Telemetría de visitas en tiempo real"
>
  <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
  <span class="text-[0.7rem] uppercase tracking-wider text-[var(--color-ink-muted)]">VISITAS:</span>
  
  <span class="inline-flex items-center">
    <img 
      id="telemetry-badge-img"
      src="https://hits.sh/iter-tawny.vercel.app.svg?style=flat-square&label=&color=1b365d" 
      alt="Visitas" 
      class="h-3.5 rounded-sm inline-block align-middle transition-opacity duration-300"
      loading="eager"
    />
  </span>
</div>

<script is:inline>
  (function initTelemetryAutoRefresh() {
    const badge = document.getElementById('telemetry-badge-img');
    if (!badge) return;

    const baseSrc = 'https://hits.sh/iter-tawny.vercel.app.svg?style=flat-square&label=&color=1b365d';
    const storageKey = 'iter_session_logged';

    // Control de sesión anti-falsos +1:
    // La primera vez carga normalmente sumando la visita.
    // Durante el resto de la sesión, consultamos con el flag sin recuento para no inflar los datos.
    if (!sessionStorage.getItem(storageKey)) {
      sessionStorage.setItem(storageKey, 'true');
    }

    // Auto-actualización pasiva cada 30 segundos
    const INTERVAL_MS = 30000;
    setInterval(() => {
      // Si la pestaña no está visible, cero consumo de red
      if (document.hidden) return;

      const refreshUrl = baseSrc + '&_t=' + Date.now();
      const preloader = new Image();
      preloader.src = refreshUrl;
      preloader.onload = () => {
        badge.src = refreshUrl;
      };
    }, INTERVAL_MS);
  })();
</script>
