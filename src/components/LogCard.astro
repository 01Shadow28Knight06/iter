---
// src/components/LogCard.astro
interface Props {
  id: string;
  title: string;
  pubDate: Date;
  version: string;
  status: 'Stable' | 'Evolving';
  slug: string;
  changelog?: { version: string; date: string; note: string }[];
}

const { id, title, pubDate, version, status, slug, changelog = [] } = Astro.props;
const formattedDate = new Date(pubDate).toISOString().split('T')[0];
---

<article class="flex flex-col gap-6 group">
    <!-- Metadatos superiores -->
    <div class="flex justify-between items-center font-mono text-xs text-[var(--color-ink-muted)] border-b border-[var(--color-rule)] pb-3">
        <span>{id} // TELEMETRÍA COGNITIVA</span>
        <div class="flex items-center gap-2">
            <span class={`px-2 py-0.5 rounded text-[0.7rem] ${status === 'Evolving' ? 'bg-[var(--color-accent)]/15 text-[var(--color-accent)] font-medium' : 'bg-[var(--color-rule)] text-[var(--color-ink-muted)]'}`}>
                {version} ({status})
            </span>
            <span class="text-[var(--color-ink-muted)]">•</span>
            <span>{formattedDate}</span>
        </div>
    </div>

    <!-- Título del Log -->
    <h2 class="font-serif text-3xl font-medium tracking-tight text-[var(--color-ink-main)] group-hover:text-[var(--color-accent)] transition-colors duration-300">
        <a href={`/logs/${slug}`}>
            {title}
        </a>
    </h2>

    <!-- Extracto del contenido -->
    <div class="font-serif text-lg leading-relaxed text-[var(--color-ink-main)]">
        <slot />
    </div>

    <!-- Footer de la tarjeta -->
    <div class="pt-4 border-t border-[var(--color-rule)] flex justify-between items-center">
        <a href={`/logs/${slug}`} class="font-sans text-sm font-medium text-[var(--color-ink-main)] hover:text-[var(--color-accent)] inline-flex items-center gap-2 transition-all duration-300 group-hover:translate-x-1">
            <span>Leer registro completo y versiones</span>
            <span>→</span>
        </a>
        <span class="font-mono text-[0.7rem] text-[var(--color-ink-muted)]">
            {changelog.length} iteraciones registradas
        </span>
    </div>
</article>
