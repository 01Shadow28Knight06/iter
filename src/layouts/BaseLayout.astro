---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "ITER // Registros Cognitivos", 
  description = "Bitácora evolutiva y telemetría de pensamiento." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <SeoHead title={title} description={description} />

    <!-- Tipografías locales de Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-[var(--color-paper)] text-[var(--color-ink-main)] font-serif min-h-screen flex justify-center py-16 px-6 selection:bg-[var(--color-accent)] selection:text-white">

    <div class="w-full max-w-[640px] flex flex-col gap-12">
        <header class="flex justify-between items-baseline border-b border-[var(--color-ink-main)] pb-3">
            <a href="/" class="font-mono text-xs tracking-widest uppercase text-[var(--color-ink-muted)] hover:text-[var(--color-ink-main)] transition-colors">
                ITER // <strong class="text-[var(--color-ink-main)] font-medium">REGISTROS</strong>
            </a>
            <span class="font-sans text-xs text-[var(--color-ink-muted)]">Vol. I — 2026</span>
        </header>

        <main class="flex flex-col gap-16">
            <slot />
        </main>

        <footer class="pt-8 border-t border-[var(--color-rule)] flex justify-between items-center text-[0.75rem] font-mono text-[var(--color-ink-muted)]">
            <span>SISTEMA ESTABLE // EDGE HOSTED</span>
            <span>ESTADO: ACTIVO</span>
        </footer>
    </div>

</body>
</html>