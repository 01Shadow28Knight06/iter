---
// src/pages/logs/[slug].astro
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChangelogView from '../../components/ChangelogView.astro';

export async function getStaticPaths() {
  const logs = await getCollection('logs');
  return logs.map((log) => ({
    params: { slug: log.id },
    props: { log },
  }));
}

const { log } = Astro.props;
const { data } = log;
const { Content } = await render(log);

const formattedDate = new Date(data.pubDate).toISOString().split('T')[0];

// Estimación de tiempo de lectura (promedio 200 palabras por minuto)
const rawText = log.body || '';
const wordCount = rawText.split(/\s+/).filter(Boolean).length;
const readTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={`${data.title} — ITER`} description={data.summary || data.title}>
    
    <article class="flex flex-col gap-8">
        <nav>
            <a href="/" class="font-mono text-xs text-[var(--color-ink-muted)] hover:text-[var(--color-ink-main)] transition-colors inline-flex items-center gap-2">
                <span>←</span>
                <span>VOLVER AL ÍNDICE</span>
            </a>
        </nav>

        <header class="flex flex-col gap-4 border-b border-[var(--color-rule)] pb-8">
            <div class="flex justify-between items-center font-mono text-xs text-[var(--color-ink-muted)]">
                <span>{data.id} // REGISTRO OFICIAL</span>
                <div class="flex items-center gap-2">
                    <span class={`px-2 py-0.5 rounded text-[0.7rem] ${data.status === 'Evolving' ? 'bg-[var(--color-accent)]/15 text-[var(--color-accent)] font-medium' : 'bg-[var(--color-rule)] text-[var(--color-ink-muted)]'}`}>
                        {data.version} ({data.status})
                    </span>
                    <span>•</span>
                    <span>{formattedDate}</span>
                    <span>•</span>
                    <span>~{readTimeMinutes} min de lectura</span>
                </div>
            </div>

            <h1 class="font-serif text-4xl font-medium tracking-tight text-[var(--color-ink-main)] leading-tight">
                {data.title}
            </h1>
        </header>

        <!-- Contenedor con la tipografía de prosa editorial -->
        <div class="prose-editorial">
            <Content />
        </div>

        <!-- Asymmetric Correspondence Footer -->
        <section class="mt-8 pt-6 border-t border-[var(--color-rule)] flex flex-col gap-3 font-serif">
            <p class="text-sm text-[var(--color-ink-muted)] italic">
                ¿Tienes una objeción, una perspectiva o algo que sumar a este registro?
            </p>
            <a 
                href={`mailto:contacto@tusitio.com?subject=Correspondencia%20${data.id}:%20${encodeURIComponent(data.title)}`}
                class="font-mono text-xs text-[var(--color-accent)] hover:underline inline-flex items-center gap-2"
            >
                <span>✉</span>
                <span>Enviar correspondencia sobre este registro</span>
            </a>
        </section>

        <!-- Historial y árbol de versiones -->
        <ChangelogView changelog={data.changelog} />
    </article>

</BaseLayout>
